% Solutions to the Chapter 4 exercises.
accumulate pond.

kind letter type.
type a, b, c letter.

pred append o:list A, o:list A, o:list A.
append [] L L.
append [H | T] L [H | R] :- append T L R.

pred len o:list A, o:int.
len [] 0.
len [_ | T] N :- len T M, N is M + 1.

pred foods o:list prop, o:list critter.
foods [] [].
foods [eats _ X | T] [X | R] :- foods T R.

pred menu o:critter, o:list critter.
menu C L :- std.findall (eats C X) Found, foods Found L.

% ANCHOR: ex1
% Exercise 4.1: one clause, no recursion. A list with
% fewer than two elements has no second one, so the
% second question fails.
pred second o:A, o:list A.
second X [_, X | _].

pred ex1.
ex1 :-
  second X [frog, fish, fly], print "second:" X,
  (second Y [heron], print Y ; print "[heron]: no").
% ANCHOR_END: ex1

% ANCHOR: ex2
% Exercise 4.2: P is a prefix of L if some list R
% joined after P gives L. Four prefixes: append
% tries every cut, and each cut gives one P.
pred prefix o:list A, o:list A.
prefix P L :- append P _ L.

pred ex2.
ex2 :- std.findall (prefix P [a, b, c]) All, print All.
% ANCHOR_END: ex2

% ANCHOR: ex3
% Exercise 4.3: collect the menu, then count it.
pred meals o:critter, o:int.
meals C N :- menu C L, len L N.

pred ex3.
ex3 :-
  meals duck D, print "duck:" D,
  meals otter O, print "otter:" O,
  meals algae A, print "algae:" A.
% ANCHOR_END: ex3

% ANCHOR: ex4
% Exercise 4.4: X and Y sit side by side if L is some
% front part, then X, then Y, then the rest. Two
% answers for [a, b, c]; append tries four cuts and
% two leave fewer than two letters after the cut.
pred next-to o:A, o:A, o:list A.
next-to X Y L :- append _ [X, Y | _] L.

pred ex4.
ex4 :-
  std.findall (next-to X Y [a, b, c]) All, print All,
  next-to b After [a, b, c], print "after b:" After.
% ANCHOR_END: ex4

main :- ex1, ex2, ex3, ex4.
